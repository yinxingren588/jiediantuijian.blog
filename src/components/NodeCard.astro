---
import type { NodeItem } from '../data/nodes';

interface Props {
  node: NodeItem;
  featured?: boolean;
  fullWidth?: boolean;
}

const { node, featured = false, fullWidth = false } = Astro.props;

// Rank badge colors
const getRankBadgeStyle = (rank: number) => {
  if (rank === 1) return 'bg-amber-500 text-white shadow-md shadow-amber-500/30 ring-2 ring-amber-300';
  if (rank === 2) return 'bg-slate-400 text-white shadow-md shadow-slate-400/30 ring-2 ring-slate-200';
  if (rank === 3) return 'bg-amber-700 text-white shadow-md shadow-amber-700/30 ring-2 ring-amber-500/40';
  return 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300';
};

const hasBuyout = node.packages?.some(p => /买断|永不过期|永久有效/.test(`${p.available || ''} ${p.name}`));
---

{fullWidth ? (
  <article
    id={node.slug}
    class="col-span-1 md:col-span-2 lg:col-span-3 relative rounded-2xl border-2 border-amber-400/90 dark:border-amber-500/70 bg-gradient-to-br from-amber-50/40 via-white to-sky-50/30 dark:from-slate-900 dark:via-slate-900 dark:to-sky-950/20 shadow-xl shadow-amber-500/10 overflow-hidden transition-all duration-300 hover:shadow-2xl hover:border-amber-400"
  >
    <!-- Top Flagship Champion Ribbon -->
    <div class="bg-gradient-to-r from-amber-500 via-amber-600 to-sky-600 px-5 py-2.5 text-white flex flex-wrap items-center justify-between text-xs font-bold tracking-wide gap-2">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-white/20 backdrop-blur-xs text-[11px] font-black uppercase tracking-wider text-amber-100">
          <svg class="w-3.5 h-3.5 text-amber-200 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          2027 年度总榜机皇首推
        </span>
        <span class="text-white text-xs sm:text-sm font-extrabold">全 IEPL 物理专线 · 全节点真实 1x 倍率 · 不限设备</span>
      </div>
      <div class="hidden md:flex items-center gap-3 text-xs text-amber-100 font-medium">
        <span>SLA 在线率 {node.uptime || '99.99%'}</span>
        <span>•</span>
        <span>含 {node.packages?.length || 9} 档完整套餐</span>
        <span>•</span>
        <span>独家 8 折码：<strong class="text-white font-mono">{node.couponCode || 'yxr888'}</strong></span>
      </div>
    </div>

    <!-- Main Content 3-Column Responsive Grid -->
    <div class="p-6 grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
      <!-- Left Column (Brand Identity, Rating & Unlocks) -->
      <div class="lg:col-span-5 flex flex-col justify-between">
        <div>
          <div class="flex items-start justify-between gap-4">
            <div class="flex items-center gap-3.5">
              <span class="w-10 h-10 rounded-2xl font-black text-lg flex items-center justify-center shrink-0 bg-gradient-to-br from-amber-400 to-amber-600 text-white shadow-lg shadow-amber-500/40 ring-4 ring-amber-200 dark:ring-amber-900/60">
                #1
              </span>
              <div>
                <div class="flex items-center gap-2 flex-wrap">
                  <h3 class="text-2xl font-black text-slate-900 dark:text-white">
                    <a href={`/nodes/${node.slug}`} class="hover:text-amber-600 dark:hover:text-amber-400 transition-colors">
                      {node.name}
                    </a>
                  </h3>
                  <span class="text-xs px-2.5 py-0.5 rounded-full font-bold bg-amber-100 dark:bg-amber-950/80 text-amber-800 dark:text-amber-300 border border-amber-300/80 dark:border-amber-800">
                    {node.categoryLabel}
                  </span>
                </div>
                <p class="text-xs sm:text-sm text-amber-600 dark:text-amber-400 font-semibold mt-1 flex items-center gap-1">
                  <span>★ {node.badge}</span>
                </p>
              </div>
            </div>

            <!-- Score -->
            <div class="text-right shrink-0">
              <div class="flex items-baseline justify-end gap-1">
                <span class="text-3xl font-black text-amber-600 dark:text-amber-400">{node.rating}</span>
                <span class="text-xs text-slate-400 font-bold">/ 10</span>
              </div>
              <span class="text-[11px] text-slate-400 block">{node.reviewsCount} 人已深度评测</span>
            </div>
          </div>

          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-4 leading-relaxed">
            {node.summary}
          </p>
        </div>

        <!-- Unlocked Streaming Pills -->
        <div class="mt-5 pt-4 border-t border-slate-200/60 dark:border-slate-800">
          <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 block mb-2">全节点支持流媒体与海外 AI 原生解锁：</span>
          <div class="flex flex-wrap gap-1.5">
            {node.streamingUnlock.map((unlock) => (
              <span class="text-xs px-2.5 py-1 rounded-md bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 font-medium border border-emerald-200/80 dark:border-emerald-800/80">
                {unlock}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Middle Column (Core Benchmarks & Key Highlights) -->
      <div class="lg:col-span-4 flex flex-col justify-between border-t lg:border-t-0 lg:border-l lg:border-r border-slate-200/80 dark:border-slate-800 lg:px-6 pt-5 lg:pt-0">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block mb-3">实测链路与架构指标</span>
          <div class="grid grid-cols-3 gap-2.5">
            <div class="bg-white dark:bg-slate-800/90 p-3 rounded-xl border border-slate-200/80 dark:border-slate-700 shadow-2xs">
              <span class="text-[11px] text-slate-400 block font-medium">峰值实测速度</span>
              <span class="text-xs font-extrabold text-slate-800 dark:text-slate-100 block mt-0.5">{node.speed}</span>
            </div>
            <div class="bg-white dark:bg-slate-800/90 p-3 rounded-xl border border-slate-200/80 dark:border-slate-700 shadow-2xs">
              <span class="text-[11px] text-slate-400 block font-medium">平均链路延迟</span>
              <span class="text-xs font-extrabold text-emerald-600 dark:text-emerald-400 block mt-0.5">{node.latency}</span>
            </div>
            <div class="bg-white dark:bg-slate-800/90 p-3 rounded-xl border border-slate-200/80 dark:border-slate-700 shadow-2xs">
              <span class="text-[11px] text-slate-400 block font-medium">骨干网络架构</span>
              <span class="text-xs font-extrabold text-indigo-600 dark:text-indigo-400 truncate block mt-0.5">{node.lineType}</span>
            </div>
          </div>

          <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block mt-5 mb-2">核心优势与独家权益</span>
          <ul class="space-y-2 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
            {node.features.slice(0, 4).map((feat) => (
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
                <span class="font-medium leading-snug">{feat}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Right Column (Pricing, Coupon & Direct CTAs) -->
      <div class="lg:col-span-3 flex flex-col justify-between bg-white dark:bg-slate-800/80 p-5 rounded-2xl border border-amber-200/80 dark:border-amber-900/50 shadow-sm">
        <div>
          <div class="flex items-center justify-between gap-2">
            <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">特惠起步价</span>
            <span class="text-[11px] px-2 py-0.5 rounded bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 font-bold border border-rose-200 dark:border-rose-800 whitespace-nowrap">
              {node.packages?.length || 9} 档全套套餐
            </span>
          </div>
          <div class="mt-2">
            <div class="flex items-baseline gap-1.5">
              <span class="text-3xl font-black text-rose-600 dark:text-rose-400">{node.monthlyPrice}</span>
            </div>
            <span class="text-xs text-slate-500 dark:text-slate-400 block mt-1">{node.traffic}</span>
            {node.annualDiscount && (
              <span class="mt-2 inline-block text-[11px] font-bold text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/60 px-2 py-1 rounded-lg border border-emerald-200 dark:border-emerald-800 leading-snug">
                🏷️ 年付折合仅 ¥7.27/月：{node.annualDiscount}
              </span>
            )}
          </div>

          {node.couponCode && (
            <div class="mt-3 p-3 bg-amber-50 dark:bg-amber-950/60 border border-amber-200 dark:border-amber-800 rounded-xl">
              <div class="flex items-center justify-between text-xs mb-1">
                <span class="text-amber-800 dark:text-amber-300 font-bold">全场通用 8 折券</span>
                <span class="text-[10px] text-amber-600 font-mono">yxr888</span>
              </div>
              <div class="flex items-center justify-between gap-2 mt-1">
                <span class="text-sm font-black font-mono text-amber-900 dark:text-amber-200 bg-white dark:bg-slate-900 px-2 py-1 rounded border border-amber-300 dark:border-amber-700 select-all">
                  {node.couponCode}
                </span>
                <button
                  type="button"
                  onclick={`copyCoupon('${node.couponCode}', event)`}
                  class="text-xs px-3 py-1 bg-amber-500 hover:bg-amber-600 text-white font-bold rounded-lg transition-all active:scale-95 shadow-xs cursor-pointer whitespace-nowrap shrink-0"
                >
                  点击复制
                </button>
              </div>
            </div>
          )}
        </div>

        <div class="mt-4 space-y-2">
          <a
            href={node.affUrl}
            target="_blank"
            rel="noopener noreferrer nofollow"
            class="w-full py-3 px-4 text-center text-sm font-extrabold rounded-xl bg-gradient-to-r from-amber-500 via-sky-600 to-blue-600 hover:from-amber-600 hover:via-sky-500 hover:to-blue-500 text-white shadow-lg shadow-sky-600/30 transition-all flex items-center justify-center gap-2 transform active:scale-98"
          >
            <span>直达隐形人官网开通</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
          <a
            href={`/nodes/${node.slug}`}
            class="w-full py-2.5 px-4 text-center text-xs font-bold rounded-xl border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors block"
          >
            查看全部 {node.packages?.length || 9} 档完整套餐与评测 →
          </a>
        </div>
      </div>
    </div>
  </article>
) : (
  <article
    id={node.slug}
    class={`h-full relative rounded-2xl border transition-all duration-300 flex flex-col justify-between overflow-hidden ${
      featured
        ? 'border-sky-500/80 bg-gradient-to-b from-sky-50/50 via-white to-white dark:from-sky-950/20 dark:via-slate-900 dark:to-slate-900 shadow-xl shadow-sky-500/10'
        : 'border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:shadow-lg hover:border-slate-300 dark:hover:border-slate-700'
    }`}
  >
    <!-- Top Header Ribbon -->
    <div class="p-6 pb-4">
      <div class="flex items-start justify-between gap-3">
        <div class="flex items-start gap-3 min-w-0">
          <!-- Rank Badge -->
          <span class={`w-8 h-8 rounded-xl font-black text-sm flex items-center justify-center shrink-0 mt-0.5 ${getRankBadgeStyle(node.rank)}`}>
            #{node.rank}
          </span>
          <div class="min-w-0">
            <div class="flex items-center gap-1.5 flex-wrap">
              <h3 class="text-lg font-bold text-slate-900 dark:text-white leading-snug">
                <a href={`/nodes/${node.slug}`} class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors">
                  {node.name}
                </a>
              </h3>
              <span class="text-[10px] px-2 py-0.5 rounded-full font-semibold bg-sky-100 dark:bg-sky-950/80 text-sky-700 dark:text-sky-300 border border-sky-200 dark:border-sky-800 whitespace-nowrap">
                {node.categoryLabel}
              </span>
            </div>
            <p class="text-xs text-amber-600 dark:text-amber-400 font-medium mt-1 truncate">
              ★ {node.badge}
            </p>
          </div>
        </div>

        <!-- Rating Score -->
        <div class="text-right shrink-0">
          <div class="flex items-baseline justify-end gap-0.5">
            <span class="text-2xl font-black text-sky-600 dark:text-sky-400">{node.rating}</span>
            <span class="text-[11px] text-slate-400">/10</span>
          </div>
          <span class="text-[10px] text-slate-400 whitespace-nowrap">{node.reviewsCount} 人已评</span>
        </div>
      </div>

      <!-- Key Metrics Badges -->
      <div class="grid grid-cols-3 gap-2 mt-5">
        <div class="bg-slate-50 dark:bg-slate-800/70 p-2.5 rounded-xl border border-slate-100 dark:border-slate-800">
          <span class="text-[10px] text-slate-400 block">实测速率</span>
          <span class="text-xs font-bold text-slate-800 dark:text-slate-100 line-clamp-2 mt-0.5">{node.speed}</span>
        </div>
        <div class="bg-slate-50 dark:bg-slate-800/70 p-2.5 rounded-xl border border-slate-100 dark:border-slate-800">
          <span class="text-[10px] text-slate-400 block">平均链路延迟</span>
          <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 line-clamp-2 mt-0.5">{node.latency}</span>
        </div>
        <div class="bg-slate-50 dark:bg-slate-800/70 p-2.5 rounded-xl border border-slate-100 dark:border-slate-800">
          <span class="text-[10px] text-slate-400 block">骨干网络架构</span>
          <span class="text-xs font-bold text-indigo-600 dark:text-indigo-400 line-clamp-2 mt-0.5">{node.lineType}</span>
        </div>
      </div>

      <!-- Summary description -->
      <p class="text-xs text-slate-600 dark:text-slate-300 mt-4 leading-relaxed line-clamp-2">
        {node.summary}
      </p>

      <!-- Supported Features Checkmarks -->
      <ul class="mt-3.5 space-y-1.5 text-xs text-slate-600 dark:text-slate-300">
        {node.features.slice(0, 3).map((feat) => (
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
            </svg>
            <span class="line-clamp-1">{feat}</span>
          </li>
        ))}
      </ul>

      <!-- Streaming & Protocols tags (Keep clean single-row height consistency on 3-col cards) -->
      <div class="mt-3.5 pt-3 border-t border-slate-100 dark:border-slate-800 flex flex-wrap gap-1.5 items-center">
        <span class="text-[11px] font-medium text-slate-400">解锁：</span>
        {node.streamingUnlock.slice(0, 4).map((unlock) => (
          <span class="text-[11px] px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 font-medium border border-emerald-100 dark:border-emerald-800/60">
            {unlock}
          </span>
        ))}
        {node.streamingUnlock.length > 4 && (
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 font-medium">
            +{node.streamingUnlock.length - 4}
          </span>
        )}
      </div>
    </div>

    <!-- Bottom Pricing & Action Section -->
    <div class="p-5 pt-4 bg-slate-50/70 dark:bg-slate-800/40 border-t border-slate-100 dark:border-slate-800 mt-auto">
      <div class="flex items-center justify-between gap-2 mb-2 flex-wrap">
        <div class="min-w-0">
          <div class="flex items-center gap-1.5">
            <span class="text-[11px] text-slate-400">参考起步价</span>
            {hasBuyout && (
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-300 font-semibold">
                支持不限时买断
              </span>
            )}
          </div>
          <div class="flex items-baseline gap-1.5 flex-wrap mt-0.5">
            <span class="text-lg font-black text-rose-600 dark:text-rose-400 whitespace-nowrap">{node.monthlyPrice}</span>
            <span class="text-[11px] text-slate-500 dark:text-slate-400 truncate max-w-[140px]">({node.traffic})</span>
          </div>
        </div>

        <!-- Coupon copy button OR Promo highlight -->
        {node.couponCode ? (
          <div class="flex items-center gap-1.5 bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800/70 rounded-lg px-2 py-1.5 shrink-0">
            <span class="text-[11px] font-bold text-amber-800 dark:text-amber-300 font-mono whitespace-nowrap">
              {node.couponCode}
            </span>
            <button
              type="button"
              onclick={`copyCoupon('${node.couponCode}', event)`}
              class="text-[10px] px-2 py-1 bg-amber-500 hover:bg-amber-600 text-white font-semibold rounded transition-colors active:scale-95 whitespace-nowrap shrink-0 cursor-pointer"
              title="点击复制优惠码"
            >
              复制优惠码
            </button>
          </div>
        ) : (
          <div class="bg-sky-50 dark:bg-sky-950/40 border border-sky-200/80 dark:border-sky-800/70 rounded-lg px-2.5 py-1.5 text-[10px] font-semibold text-sky-700 dark:text-sky-300 max-w-[140px] truncate" title={node.couponText}>
            {node.couponText}
          </div>
        )}
      </div>

      {node.annualDiscount && (
        <div class="text-[11px] text-emerald-700 dark:text-emerald-400 font-semibold truncate mb-3.5" title={node.annualDiscount}>
          🏷️ 年付特惠：{node.annualDiscount}
        </div>
      )}

      <!-- Buttons -->
      <div class="grid grid-cols-2 gap-2">
        <a
          href={`/nodes/${node.slug}`}
          class="py-2.5 px-2 text-center text-xs font-semibold rounded-xl border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-white dark:hover:bg-slate-800 transition-colors whitespace-nowrap"
        >
          {node.packages?.length ? `${node.packages.length}档套餐详情` : '详细深度评测'}
        </a>
        <a
          href={node.affUrl}
          target="_blank"
          rel="noopener noreferrer nofollow"
          class="py-2.5 px-2 text-center text-xs font-semibold rounded-xl bg-gradient-to-r from-sky-600 to-blue-600 hover:from-sky-500 hover:to-blue-500 text-white shadow-sm shadow-sky-600/30 transition-all flex items-center justify-center gap-1 whitespace-nowrap"
        >
          <span>直达节点官网</span>
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </a>
      </div>
    </div>
  </article>
)}

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BLOG_POSTS, BLOG_CATEGORIES } from '../../data/blogs';

const title = "2027节点推荐深度专栏与测速周报 - 实测天梯/IEPL选购/分流规则实战 | jiediantuijian.blog";
const description = "jiediantuijian.blog 官方深度技术博客专栏。定期发布2027节点推荐月度晚高峰实测报告、IEPL物理专线选购避坑、ChatGPT/Claude/TikTok纯净IP基建教程与Clash/软路由高阶规则配置。";
const keywords = "2027节点推荐博客, 机场测速报告, IEPL专线评测, ChatGPT防封教程, Clash分流规则, 软路由科学上网";

const featuredPost = BLOG_POSTS.find(p => p.featured) || BLOG_POSTS[0];
const otherPosts = BLOG_POSTS.filter(p => p.slug !== featuredPost.slug);

const blogSchema = {
  "@type": "Blog",
  "name": "2027节点推荐技术评测专栏",
  "description": description,
  "url": "https://jiediantuijian.blog/blog",
  "blogPost": BLOG_POSTS.map(post => ({
    "@type": "BlogPosting",
    "headline": post.title,
    "description": post.excerpt,
    "datePublished": post.publishDate,
    "dateModified": post.updateDate,
    "url": `https://jiediantuijian.blog/blog/${post.slug}`
  }))
};
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  canonicalPath="/blog"
  jsonLd={blogSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs text-slate-500 mb-6 space-x-2">
      <a href="/" class="hover:text-sky-600 transition-colors">首页</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold">深度博客专栏</span>
    </nav>

    <!-- Editorial Header -->
    <div class="text-center max-w-3xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-100 dark:bg-sky-950/80 text-sky-800 dark:text-sky-300 text-xs font-semibold mb-3">
        <span>jiediantuijian.blog Editorial</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
        2027节点推荐 · 深度技术与实测专栏
      </h1>
      <p class="mt-3 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
        深度剖析网络底层链路、晚高峰测速月报、AI/外贸风控底层逻辑与生产级分流实战，助您用专业视角玩转 2027 全球高速节点。
      </p>
    </div>

    <!-- Search & Filter Bar -->
    <div class="mb-10 p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs flex flex-col md:flex-row gap-4 items-stretch md:items-center justify-between">
      <div class="flex flex-wrap gap-1.5" id="blog-category-tabs">
        {BLOG_CATEGORIES.map((cat, idx) => (
          <button
            type="button"
            data-category={cat.id}
            class={`blog-cat-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all cursor-pointer ${
              idx === 0
                ? 'bg-sky-600 text-white shadow-xs'
                : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700'
            }`}
          >
            {cat.label}
          </button>
        ))}
      </div>
      <div class="relative w-full md:w-72">
        <input
          type="text"
          id="blog-search"
          placeholder="搜索专栏文章关键词..."
          class="w-full pl-9 pr-4 py-2 text-xs rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-sky-500"
        />
        <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </div>
    </div>

    <!-- Featured Lead Post -->
    <article
      class="blog-item mb-10 rounded-3xl border-2 border-sky-200 dark:border-sky-800/80 bg-gradient-to-br from-sky-50/70 via-white to-indigo-50/40 dark:from-slate-900 dark:via-slate-900 dark:to-sky-950/30 p-6 sm:p-8 lg:p-10 shadow-md hover:shadow-xl transition-all"
      data-category={featuredPost.category}
      data-search={`${featuredPost.title} ${featuredPost.excerpt} ${featuredPost.tags.join(' ')}`.toLowerCase()}
    >
      <div class="flex flex-wrap items-center gap-2.5 mb-4">
        <span class="px-3 py-1 rounded-full text-xs font-black bg-amber-500 text-white shadow-xs">
          ★ 本期置顶重磅报告
        </span>
        <span class="px-3 py-1 rounded-full text-xs font-bold bg-sky-100 dark:bg-sky-950 text-sky-700 dark:text-sky-300 border border-sky-200 dark:border-sky-800">
          {featuredPost.categoryLabel}
        </span>
        <span class="text-xs text-slate-400">
          更新于 {featuredPost.updateDate} • {featuredPost.readingTime}
        </span>
      </div>

      <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white leading-tight mb-3">
        <a href={`/blog/${featuredPost.slug}`} class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors">
          {featuredPost.title}
        </a>
      </h2>
      <p class="text-sm text-sky-700 dark:text-sky-300 font-semibold mb-3">
        {featuredPost.subtitle}
      </p>
      <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed max-w-4xl mb-6">
        {featuredPost.excerpt}
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 mb-6 bg-white/80 dark:bg-slate-800/60 p-4 rounded-2xl border border-slate-200/70 dark:border-slate-700/70">
        {featuredPost.keyTakeaways.slice(0, 4).map(point => (
          <div class="flex items-start gap-2 text-xs text-slate-700 dark:text-slate-300">
            <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            <span>{point}</span>
          </div>
        ))}
      </div>

      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap gap-1.5">
          {featuredPost.tags.map(t => (
            <span class="text-[11px] px-2.5 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
              #{t}
            </span>
          ))}
        </div>
        <a
          href={`/blog/${featuredPost.slug}`}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-sky-600 to-blue-600 hover:from-sky-500 hover:to-blue-500 text-white text-xs font-bold shadow-md shadow-sky-600/25 transition-all"
        >
          <span>阅读完整深度评测全文</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>
    </article>

    <!-- Remaining Editorial Blog Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="blog-grid">
      {otherPosts.map(post => (
        <article
          class="blog-item rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 flex flex-col justify-between shadow-xs hover:shadow-lg hover:border-sky-300 dark:hover:border-sky-700 transition-all"
          data-category={post.category}
          data-search={`${post.title} ${post.excerpt} ${post.tags.join(' ')}`.toLowerCase()}
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-sky-50 dark:bg-sky-950/70 text-sky-700 dark:text-sky-300 border border-sky-200/80 dark:border-sky-800">
                {post.categoryLabel}
              </span>
              <span class="text-[11px] text-slate-400">{post.readingTime}</span>
            </div>

            <h2 class="text-lg font-extrabold text-slate-900 dark:text-white leading-snug mb-2">
              <a href={`/blog/${post.slug}`} class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors">
                {post.title}
              </a>
            </h2>

            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed line-clamp-3 mb-4">
              {post.excerpt}
            </p>

            <div class="flex flex-wrap gap-1 mb-4">
              {post.tags.slice(0, 3).map(t => (
                <span class="text-[10px] px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400">
                  #{t}
                </span>
              ))}
            </div>
          </div>

          <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs">
            <span class="text-[11px] text-slate-400">更新于 {post.updateDate}</span>
            <a
              href={`/blog/${post.slug}`}
              class="font-bold text-sky-600 dark:text-sky-400 hover:underline flex items-center gap-1"
            >
              <span>阅读全文</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Empty State -->
    <div id="blog-empty" class="hidden text-center py-16 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 mt-4">
      <p class="text-sm font-bold text-slate-700 dark:text-slate-300">未找到匹配的专栏文章</p>
      <p class="text-xs text-slate-400 mt-1">请尝试清除关键字或切换分类标签</p>
    </div>
  </div>

  <script is:inline>
    (function() {
      const catBtns = document.querySelectorAll('.blog-cat-btn');
      const searchEl = document.getElementById('blog-search');
      const items = document.querySelectorAll('.blog-item');
      const emptyEl = document.getElementById('blog-empty');

      let activeCat = 'all';
      let keyword = '';

      function filterBlog() {
        let count = 0;
        items.forEach(item => {
          const cat = item.getAttribute('data-category');
          const text = item.getAttribute('data-search') || '';
          const matchCat = activeCat === 'all' || cat === activeCat;
          const matchKey = !keyword || text.includes(keyword);
          if (matchCat && matchKey) {
            item.style.display = '';
            count++;
          } else {
            item.style.display = 'none';
          }
        });
        if (emptyEl) emptyEl.classList.toggle('hidden', count > 0);
      }

        catBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          catBtns.forEach(b => {
            b.classList.remove('bg-sky-600', 'text-white', 'shadow-xs', 'hover:bg-sky-500');
            b.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300', 'hover:bg-slate-200', 'dark:hover:bg-slate-700');
          });
          btn.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300', 'hover:bg-slate-200', 'dark:hover:bg-slate-700');
          btn.classList.add('bg-sky-600', 'text-white', 'shadow-xs', 'hover:bg-sky-500');
          activeCat = btn.getAttribute('data-category') || 'all';
          filterBlog();
        });
      });

      if (searchEl) {
        searchEl.addEventListener('input', e => {
          keyword = e.target.value.trim().toLowerCase();
          filterBlog();
        });
      }
    })();
  </script>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CLIENT_LIST } from '../../data/clients';

const title = "2027节点推荐客户端教程大全 - Clash/小火箭/Sing-box全平台配置指南 | jiediantuijian.blog";
const description = "2027节点推荐全平台客户端安装与订阅导入指南。包含Windows、Mac、iOS、Android等主流平台的Clash Verge Rev、Shadowrocket小火箭、Sing-box配置图文教程，小白5秒极速上手。";
const keywords = "2027节点推荐, 客户端教程, clash教程, 小火箭配置, sing-box教程, 节点订阅导入, 科学上网教程";
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  canonicalPath="/tutorials"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs text-slate-500 mb-6 space-x-2">
      <a href="/" class="hover:text-sky-600 transition-colors">首页</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold">客户端教程中心</span>
    </nav>

    <!-- Header Section -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
        2027主流客户端安装与配置指南
      </h1>
      <p class="mt-3 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
        无论您使用的是 Windows 电脑、苹果 iPhone、Mac 还是安卓设备，遵循以下教程均可在 1 分钟内完成 2027 推荐节点的订阅导入与科学上网。
      </p>
    </div>

    <!-- Client Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {CLIENT_LIST.map((client) => (
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 flex flex-col justify-between shadow-xs hover:shadow-md transition-all">
          <div>
            <div class="flex items-center justify-between mb-3 gap-2">
              <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                {client.osLabel}
              </span>
              <span class="text-[11px] text-sky-600 dark:text-sky-400 font-medium whitespace-nowrap">{client.badge}</span>
            </div>
            <h2 class="text-lg font-bold text-slate-900 dark:text-white mb-2">{client.name}</h2>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mb-4">
              {client.desc}
            </p>
            <div class="text-[11px] text-slate-500 mb-4">
              <span class="font-medium text-slate-700 dark:text-slate-300">支持协议：</span>
              {client.protocolSupport.join(', ')}
            </div>
          </div>

          <a
            href={client.tutorialUrl}
            class="w-full py-2.5 px-3 text-center text-xs font-semibold text-white bg-sky-600 hover:bg-sky-500 rounded-xl transition-colors shadow-xs"
          >
            阅读详细图文指南 →
          </a>
        </div>
      ))}
    </div>

    <!-- 3 Step Quick Guide -->
    <div class="p-8 rounded-3xl bg-slate-100/70 dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800">
      <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-6 text-center">
        通用节点配置 3 步核心口诀
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs text-slate-600 dark:text-slate-300">
        <div class="p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
          <span class="text-sky-600 font-bold text-sm block mb-1">第一步：复制节点订阅</span>
          <p>在 2027 节点推荐服务商后台（如隐形人、暮光加速、微风网络），复制你的专用「订阅链接」或点击「Clash/小火箭一键导入」。</p>
        </div>
        <div class="p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
          <span class="text-sky-600 font-bold text-sm block mb-1">第二步：导入客户端并更新</span>
          <p>粘贴到客户端的订阅或配置列表，点击下载并成功同步出所有可用海外国家节点列表。</p>
        </div>
        <div class="p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
          <span class="text-sky-600 font-bold text-sm block mb-1">第三步：开启系统代理与分流</span>
          <p>推荐选择「Rule（规则分流）」模式，国内直连、国外加速，开启系统代理即可尽享丝滑外网体验。</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

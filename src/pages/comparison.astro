---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComparisonTable from '../components/ComparisonTable.astro';

const title = "2027节点推荐横向对比表 - 35家主流梯子与专线节点深度横评 | jiediantuijian.blog";
const description = "2027最新节点梯子全量横向综合评测对比。支持筛选IEPL/IPLC专线、AI外贸纯净IP及平价节点，支持按月费、评分、排名实时排序，助您快速挑选最适合的节点服务。";
const keywords = "2027节点推荐, 节点对比, 机场横评, IPLC专线对比, 便宜节点对比, Clash节点测评, 梯子横向评测";
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  canonicalPath="/comparison"
  showProgressBar={true}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs text-slate-500 mb-6 space-x-2">
      <a href="/" class="hover:text-sky-600 transition-colors">首页</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold">2027节点推荐横向对比</span>
    </nav>

    <!-- Header Section -->
    <div class="text-center max-w-3xl mx-auto mb-10">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-sky-100 dark:bg-sky-950/80 text-sky-800 dark:text-sky-300 text-xs font-semibold mb-3">
        <span>35家主流品牌实时交互横评面板</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
        2027节点推荐多维度横向综合对比
      </h1>
      <p class="mt-3 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
        告别选择困难症！基于真实千兆专线环境测速跑分与晚高峰实测数据，全面横向对比全部 35 家推荐节点的技术架构与使用成本，支持一键过滤专线与价格排序。
      </p>
    </div>

    <!-- Main Interactive Comparison Table -->
    <div class="mb-14">
      <ComparisonTable />
    </div>

    <!-- Detailed Guide Sections -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex flex-col justify-between">
        <div>
          <h2 class="text-base font-bold text-slate-900 dark:text-white mb-2 flex items-center gap-2">
            <span class="w-6 h-6 rounded-lg bg-sky-100 dark:bg-sky-950 text-sky-600 dark:text-sky-400 flex items-center justify-center text-xs font-bold">1</span>
            重度4K/8K追剧与外贸办公
          </h2>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mb-3">
            首选<strong>隐形人 (Invisible)</strong> 或 <strong>暮光加速 (Twilight)</strong>。纯 IEPL/IPLC 物理专线，晚高峰 0 丢包，海外纯净住宅 IP，杜绝风控与卡顿。
          </p>
        </div>
        <a href="/nodes/invisible" class="text-xs font-semibold text-sky-600 dark:text-sky-400 hover:underline">查看隐形人深度评测 →</a>
      </div>

      <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex flex-col justify-between">
        <div>
          <h2 class="text-base font-bold text-slate-900 dark:text-white mb-2 flex items-center gap-2">
            <span class="w-6 h-6 rounded-lg bg-emerald-100 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-xs font-bold">2</span>
            学生党与平民性价比
          </h2>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mb-3">
            首选<strong>飞猫云 (FlyCat)</strong> 或 <strong>光年梯 (GuangNianTi)</strong>。月付仅需十多元，大带宽大流量，解锁主流流媒体，性价比极高。
          </p>
        </div>
        <a href="/nodes/flycat" class="text-xs font-semibold text-sky-600 dark:text-sky-400 hover:underline">查看飞猫云评测 →</a>
      </div>

      <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex flex-col justify-between">
        <div>
          <h2 class="text-base font-bold text-slate-900 dark:text-white mb-2 flex items-center gap-2">
            <span class="w-6 h-6 rounded-lg bg-indigo-100 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-xs font-bold">3</span>
            技术极客与跨境电商
          </h2>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mb-3">
            首选<strong>大佬云 (DalaoCloud)</strong> 或 <strong>跨界云 (Kuajie)</strong>。骨干网豪华，纯净商宽 IP，TikTok 与 AI 工具免封免验证。
          </p>
        </div>
        <a href="/nodes/dalaocloud" class="text-xs font-semibold text-sky-600 dark:text-sky-400 hover:underline">查看大佬云评测 →</a>
      </div>
    </div>
  </div>
</BaseLayout>

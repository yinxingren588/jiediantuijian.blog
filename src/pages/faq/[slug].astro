---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { FAQS_LIST, type FaqItem } from '../../data/faqs';
import { NODE_LIST } from '../../data/nodes';
import { formatInlineRichText } from '../../utils/formatText';

export async function getStaticPaths() {
  return FAQS_LIST.map((faq) => ({
    params: { slug: faq.slug },
    props: { faq }
  }));
}

interface Props {
  faq: FaqItem;
}

const { faq } = Astro.props;

const title = `${faq.question} - 2027节点推荐权威深度解答 | jiediantuijian.blog`;
const description = `【2027节点推荐深度问答】${faq.summary} 评测室为您详细解析：${faq.answer.slice(0, 110)}...`;
const keywords = `${faq.tags.join(', ')}, 2027节点推荐, 梯子常见问题, ${faq.categoryLabel}, 节点报错排查`;

// Matched recommended nodes
const matchedNodes = NODE_LIST.filter((n) => faq.recommendedNodeSlugs.includes(n.slug)).slice(0, 3);

// Matched related FAQs
const relatedFaqs = FAQS_LIST.filter((f) => faq.relatedFaqSlugs.includes(f.slug) && f.slug !== faq.slug).slice(0, 3);

// Schema.org Structured Data: Article + FAQPage
const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `https://jiediantuijian.blog/faq/${faq.slug}/#article`,
      "isPartOf": {
        "@type": "WebPage",
        "@id": `https://jiediantuijian.blog/faq/${faq.slug}/`
      },
      "headline": faq.question,
      "description": faq.summary,
      "datePublished": `${faq.publishDate}T08:00:00+08:00`,
      "dateModified": `${faq.updateDate}T12:00:00+08:00`,
      "author": {
        "@type": "Organization",
        "name": faq.author,
        "url": "https://jiediantuijian.blog"
      },
      "publisher": {
        "@type": "Organization",
        "name": "2027节点推荐",
        "url": "https://jiediantuijian.blog"
      },
      "mainEntityOfPage": `https://jiediantuijian.blog/faq/${faq.slug}/`
    },
    {
      "@type": "FAQPage",
      "@id": `https://jiediantuijian.blog/faq/${faq.slug}/#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": faq.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": faq.answer
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  canonicalPath={`/faq/${faq.slug}`}
  ogType="article"
  showProgressBar={true}
  jsonLd={schemaData}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs text-slate-500 mb-6 space-x-2 flex-wrap">
      <a href="/" class="hover:text-sky-600 transition-colors">首页</a>
      <span>/</span>
      <a href="/faq" class="hover:text-sky-600 transition-colors">常见问题 FAQ</a>
      <span>/</span>
      <span class="text-sky-600 font-medium">{faq.categoryLabel}</span>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold truncate max-w-[200px] sm:max-w-xs">{faq.question}</span>
    </nav>

    <!-- Main Article Header -->
    <header class="mb-8 pb-8 border-b border-slate-200 dark:border-slate-800">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="px-3 py-1 rounded-full text-xs font-bold bg-sky-100 dark:bg-sky-950/80 text-sky-700 dark:text-sky-300 border border-sky-200 dark:border-sky-800">
          {faq.categoryLabel}
        </span>
        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60">
          <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
          2027 真实环境验证通过
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 dark:text-white tracking-tight leading-snug">
        {faq.question}
      </h1>

      <!-- Meta Bar -->
      <div class="mt-4 flex flex-wrap items-center gap-4 text-xs text-slate-500 dark:text-slate-400">
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          <span>编撰审定：<strong class="text-slate-700 dark:text-slate-200">{faq.author}</strong></span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          <span>更新日期：{faq.updateDate}</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>阅读时间：{faq.readingTime}</span>
        </div>
      </div>
    </header>

    <!-- Key Takeaways Highlight Box -->
    <div class="mb-10 p-6 sm:p-7 rounded-2xl bg-gradient-to-br from-amber-500/10 via-sky-500/5 to-blue-500/10 border-2 border-amber-300/80 dark:border-amber-600/40 shadow-sm">
      <div class="flex items-center gap-2 mb-3">
        <span class="w-7 h-7 rounded-lg bg-amber-500 text-white flex items-center justify-center font-black text-sm shrink-0 shadow-xs">
          ★
        </span>
        <h2 class="text-base sm:text-lg font-black text-slate-900 dark:text-white">
          本题核心结论与专家速答
        </h2>
      </div>

      <p class="text-sm text-slate-700 dark:text-slate-200 leading-relaxed font-medium mb-4 pl-0 sm:pl-9">
        {faq.answer}
      </p>

      {faq.keyTakeaways && faq.keyTakeaways.length > 0 && (
        <div class="mt-3 pt-3 border-t border-amber-200/60 dark:border-amber-800/40 pl-0 sm:pl-9">
          <span class="text-xs font-bold text-amber-800 dark:text-amber-300 block mb-2">
            核心要点清单：
          </span>
          <ul class="space-y-1.5 text-xs text-slate-600 dark:text-slate-300">
            {faq.keyTakeaways.map(point => (
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-amber-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <!-- Table of Contents -->
    {faq.sections && faq.sections.length > 1 && (
      <nav class="mb-10 p-5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/80 dark:bg-slate-900/60">
        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider block mb-2">
          目录导航
        </span>
        <ol class="space-y-1.5 text-xs sm:text-sm">
          {faq.sections.map((sec, idx) => (
            <li>
              <a
                href={`#section-${idx}`}
                class="text-sky-600 dark:text-sky-400 hover:underline flex items-center gap-1.5"
              >
                <span class="text-slate-400 font-mono">0{idx + 1}.</span>
                <span>{sec.heading}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <!-- In-Depth Article Content Sections -->
    <article class="article-prose max-w-none space-y-8">
      {faq.sections.map((section, idx) => (
        <section id={`section-${idx}`} class="scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white pb-3 border-b border-slate-100 dark:border-slate-800 flex items-center gap-2">
            <span>{section.heading}</span>
          </h2>

          <div class="mt-4 space-y-3.5 text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-relaxed">
            {section.content.map(p => (
              <p class="leading-relaxed" set:html={formatInlineRichText(p)} />
            ))}
          </div>

          <!-- Optional Callout Box -->
          {section.callout && (
            <div class={`my-5 p-4 rounded-xl border ${
              section.callout.type === 'warning'
                ? 'bg-rose-50/70 dark:bg-rose-950/30 border-rose-200 dark:border-rose-900/60 text-rose-900 dark:text-rose-200'
                : section.callout.type === 'tip'
                  ? 'bg-emerald-50/70 dark:bg-emerald-950/30 border-emerald-200 dark:border-emerald-900/60 text-emerald-900 dark:text-emerald-200'
                  : 'bg-sky-50/70 dark:bg-sky-950/30 border-sky-200 dark:border-sky-900/60 text-sky-900 dark:text-sky-200'
            }`}>
              <div class="flex items-center gap-2 font-bold text-xs sm:text-sm mb-1">
                {section.callout.type === 'warning' && (
                  <svg class="w-4 h-4 text-rose-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                )}
                {section.callout.type === 'tip' && (
                  <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
                )}
                {section.callout.type === 'info' && (
                  <svg class="w-4 h-4 text-sky-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                )}
                <span>{section.callout.title}</span>
              </div>
              <p class="text-xs sm:text-sm leading-relaxed !mb-0" set:html={formatInlineRichText(section.callout.text)} />
            </div>
          )}

          <!-- Optional Code Block with Copy Action -->
          {section.codeBlock && (
            <div class="my-5 rounded-xl overflow-hidden border border-slate-800 bg-slate-950 text-slate-200 shadow-sm">
              <div class="px-4 py-2.5 bg-slate-900 border-b border-slate-800 text-xs font-mono text-slate-300 flex items-center justify-between gap-2">
                <div class="flex items-center gap-2 min-w-0">
                  <span class="text-[10px] uppercase font-bold px-1.5 py-0.5 rounded bg-sky-900/70 text-sky-300">{section.codeBlock.language}</span>
                  <span class="truncate">{section.codeBlock.title || '配置代码规则'}</span>
                </div>
                <button
                  type="button"
                  onclick="window.copyText(this.closest('.rounded-xl').querySelector('code').textContent, '配置已复制', '可直接粘贴到客户端配置文件中使用', this)"
                  class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-sky-400 text-[11px] font-semibold transition-colors whitespace-nowrap shrink-0 cursor-pointer"
                >
                  复制规则
                </button>
              </div>
              <pre class="p-4 text-xs font-mono overflow-x-auto leading-relaxed text-emerald-400"><code>{section.codeBlock.code}</code></pre>
            </div>
          )}
        </section>
      ))}
    </article>

    <!-- Contextual Recommended Nodes Widget -->
    {matchedNodes.length > 0 && (
      <div class="mt-14 p-6 sm:p-8 rounded-2xl border border-sky-200 dark:border-sky-800 bg-sky-50/50 dark:bg-sky-950/20">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-sky-600 dark:text-sky-400">
              Solution Recommendation
            </span>
            <h3 class="text-lg font-black text-slate-900 dark:text-white">
              针对本技术场景：2027 官方推荐首选节点
            </h3>
          </div>
          <a href="/nodes" class="text-xs font-bold text-sky-600 hover:text-sky-700 dark:text-sky-400 flex items-center gap-1">
            <span>查看完整 35 家推荐榜</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
          {matchedNodes.map(node => (
            <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 flex flex-col justify-between shadow-2xs">
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="text-xs font-black text-amber-500">#{node.rank}</span>
                  <span class="text-xs font-bold text-sky-600">{node.rating} 分</span>
                </div>
                <h4 class="text-sm font-bold text-slate-900 dark:text-white truncate">
                  {node.name}
                </h4>
                <p class="text-xs text-slate-500 mt-1 line-clamp-2">
                  {node.summary}
                </p>
                <div class="mt-2 text-xs font-bold text-rose-600 dark:text-rose-400">
                  {node.monthlyPrice}
                </div>
              </div>

              <div class="mt-3 pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center gap-2">
                <a
                  href={`/nodes/${node.slug}`}
                  class="flex-1 py-1.5 text-center text-xs font-semibold rounded-lg border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800"
                >
                  评测
                </a>
                <a
                  href={node.affUrl}
                  target="_blank"
                  rel="noopener noreferrer nofollow"
                  class="flex-1 py-1.5 text-center text-xs font-bold rounded-lg bg-sky-600 hover:bg-sky-500 text-white shadow-2xs"
                >
                  直达官网
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Related FAQs List -->
    {relatedFaqs.length > 0 && (
      <div class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-800">
        <h3 class="text-lg font-black text-slate-900 dark:text-white mb-4">
          您可能还对以下 2027 节点问题感兴趣：
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {relatedFaqs.map(rf => (
            <a
              href={`/faq/${rf.slug}`}
              class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-sky-500 hover:shadow-xs transition-all group flex flex-col justify-between"
            >
              <div>
                <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-500 block w-fit mb-2">
                  {rf.categoryLabel}
                </span>
                <h4 class="text-xs font-bold text-slate-800 dark:text-slate-100 group-hover:text-sky-600 line-clamp-2">
                  {rf.question}
                </h4>
              </div>
              <span class="text-[11px] font-semibold text-sky-600 group-hover:translate-x-0.5 transition-transform mt-3 block">
                阅读详解 →
              </span>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Back to FAQ directory button -->
    <div class="mt-12 text-center">
      <a
        href="/faq"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 font-bold text-sm transition-all"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        <span>返回 2027 常见问题 FAQ 知识库主页（查看全部 24 篇）</span>
      </a>
    </div>
  </div>
</BaseLayout>